---
// Inline SVG map with regions highlighted from a {code, name} list; hover tooltips.
import worldSvg from '../assets/maps/world.svg?raw';
import usSvg from '../assets/maps/us.svg?raw';
const { map, regions, title } = Astro.props; // map: 'world' | 'us'
let svg = (map === 'world' ? worldSvg : usSvg)
  .replace(/<\?xml[^>]*\?>/g, '')
  .replace(/<!DOCTYPE[^>]*>/g, '')
  // The source maps ship their own <style> blocks which override our palette
  // (seen as ugly state colors); strip them so global.css rules apply.
  .replace(/<style[\s\S]*?<\/style>/g, '');
const data = Object.fromEntries(regions.map((r) => [r.code, r.name]));
// <-escape so no region name can ever close the JSON <script> island.
const dataJson = JSON.stringify(data).replace(/</g, '\\u003c');
const label = `Map of ${title ?? map}: ${regions.length} visited regions highlighted`;
---
<figure class="map-wrap" data-map={map}>
  {title && <figcaption class="map-title">{title} · <span data-count>{regions.length}</span> so far</figcaption>}
  <div class="map-svg" role="img" aria-label={label} set:html={svg} />
  <script type="application/json" data-visited set:html={dataJson} />
</figure>

<script>
  let tip = null;
  // Re-appliable so the Travel page's live sheet refresh can update regions.
  window.applyVisited = function (wrap, visited) {
    const svg = wrap.querySelector('svg');
    if (!svg) return;
    const count = wrap.querySelector('[data-count]');
    if (count) count.textContent = String(Object.keys(visited).length);
    for (const el of svg.querySelectorAll('.visited')) el.classList.remove('visited');
    for (const [code, name] of Object.entries(visited)) {
      const el = svg.querySelector(`#${code.toLowerCase()}`) || svg.querySelector(`#${code}`);
      if (!el) continue;
      el.classList.add('visited');
      if (!el.dataset.tipBound) {
        el.dataset.tipBound = '1';
        el.addEventListener('mousemove', (e) => showTip(el.dataset.tipName, e.clientX, e.clientY));
        el.addEventListener('mouseleave', hideTip);
      }
      el.dataset.tipName = name;
    }
  };
  function showTip(text, x, y) {
    if (!tip) {
      tip = document.createElement('div');
      tip.className = 'map-tooltip';
      document.body.appendChild(tip);
    }
    tip.textContent = text;
    tip.style.left = `${x}px`;
    tip.style.top = `${y}px`;
    tip.hidden = false;
  }
  function hideTip() {
    if (tip) tip.hidden = true;
  }
  for (const wrap of document.querySelectorAll('.map-wrap')) {
    const dataEl = wrap.querySelector('[data-visited]');
    if (!dataEl) continue;
    window.applyVisited(wrap, JSON.parse(dataEl.textContent || '{}'));
  }
</script>
