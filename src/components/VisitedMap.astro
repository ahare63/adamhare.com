---
// Inline SVG map with regions highlighted from a {code, name} list; hover tooltips.
import { readFileSync } from 'node:fs';
const { map, regions, title } = Astro.props; // map: 'world' | 'us'
let svg = readFileSync(new URL(`../assets/maps/${map}.svg`, import.meta.url), 'utf-8');
svg = svg.replace(/<\?xml[^>]*\?>/g, '').replace(/<!DOCTYPE[^>]*>/g, '');
const data = Object.fromEntries(regions.map((r) => [r.code, r.name]));
---
<figure class="map-wrap" data-map={map}>
  {title && <figcaption class="map-title">{title} · {regions.length} so far</figcaption>}
  <div class="map-svg" set:html={svg} />
  <script type="application/json" data-visited set:html={JSON.stringify(data)} />
</figure>

<script>
  let tip = null;
  function showTip(text, x, y) {
    if (!tip) {
      tip = document.createElement('div');
      tip.className = 'map-tooltip';
      document.body.appendChild(tip);
    }
    tip.textContent = text;
    tip.style.left = `${x}px`;
    tip.style.top = `${y}px`;
    tip.hidden = false;
  }
  function hideTip() {
    if (tip) tip.hidden = true;
  }
  for (const wrap of document.querySelectorAll('.map-wrap')) {
    const dataEl = wrap.querySelector('[data-visited]');
    const svg = wrap.querySelector('svg');
    if (!dataEl || !svg) continue;
    const visited = JSON.parse(dataEl.textContent || '{}');
    for (const [code, name] of Object.entries(visited)) {
      const el = svg.querySelector(`#${code.toLowerCase()}`) || svg.querySelector(`#${code}`);
      if (!el) continue;
      el.classList.add('visited');
      el.addEventListener('mousemove', (e) => showTip(name, e.clientX, e.clientY));
      el.addEventListener('mouseleave', hideTip);
    }
  }
</script>
