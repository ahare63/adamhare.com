---
import Base from '../layouts/Base.astro';
import * as md from '../content/background.md';

// The page is long, so each h3 subsection (roles, degrees) collapses; the
// first in each h2 group (current role, most recent degree) starts open.
let html = await md.compiledContent();
let openNext = false;
html = html.replace(
  /(<h2[^>]*>[\s\S]*?<\/h2>)|(<h3[^>]*>[\s\S]*?<\/h3>)([\s\S]*?)(?=<h3|<h2|$)/g,
  (m, h2, heading, body) => {
    if (h2) { openNext = true; return h2; }
    const attr = openNext ? ' open' : '';
    openNext = false;
    return `<details${attr}><summary>${heading}</summary>${body}</details>`;
  }
);
---
<Base title={md.frontmatter.title} description={md.frontmatter.description} banner="/images/banners/background.jpg" bannerTitle={md.frontmatter.title} bannerPosition="center 45%">
  <p class="lede">
    Where I’ve worked and what I studied: my roles at Zoomi, the Air Force Institute of Technology and
    LexisNexis, and my degrees from Oxford and Princeton. Each entry expands for the details.
  </p>
  <div class="background" set:html={html} />

  <style>
    .background :global(img) { max-height: 220px; width: auto; max-width: 100%; }
    .background :global(details) { border-top: 1px solid var(--rule); }
    .background :global(summary) { cursor: pointer; padding: 0.45rem 0; }
    .background :global(summary h3) { display: inline; margin: 0; }
  </style>
</Base>
