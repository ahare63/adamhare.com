---
import Base from '../layouts/Base.astro';
import * as booksMd from '../content/books.md';
import essays from '../data/essays.json';
import concerts from '../data/concerts.json';
import movies from '../data/movies.json';
import liveEvents from '../data/live-events.json';
import { recentFirst, longDate, newestBooks } from '../lib/lately.js';
import finished from '../data/finished.json';

// "Lately" is derived at build time from data that is already kept current:
// the newest bullet in books.md, the Substack snapshot, the concert list, the Letterboxd
// diary and the Live Events tab.
const esc = (t) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const italics = (t) => esc(t).replace(/\*([^*]+)\*/g, '<em>$1</em>');
// The bullet's italic title goes on the main line; what follows it (author, translator,
// editor, note) goes on the small line with the date.
const latestBooks = newestBooks(booksMd.rawContent(), finished).map((b) => {
  const m = b.line.match(/^\*((?:\\.|[^*\\])+)\*(.*)$/);
  const title = m ? `<em>${esc(m[1].replace(/\\(.)/g, '$1'))}</em>` : italics(b.line);
  const byline = m ? m[2].replace(/^\s*(by\s+|,\s*)/, '').trim() : '';
  const when = b.finished ? longDate(b.finished) : `Book ${b.number} of ${b.year}`;
  return { ...b, title, detail: byline ? `${italics(byline)} · ${when}` : when };
});
const latestBook = latestBooks[0] ?? null;

const fmtMonth = (iso) =>
  new Date(`${iso}T12:00:00Z`).toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });
const latestEssay = essays[0];

const recentShow = recentFirst(concerts, (c) => Date.parse(c.date));
const recentFilm = recentFirst(movies.diary, (d) => Date.parse(d.watched));
const recentEvent = recentFirst(liveEvents, (e) => Date.parse(e.date));
const columns = [latestBook, recentFilm || recentEvent, recentShow].filter(Boolean).length || 1;
---
<Base description="Adam Hare — technical generalist leading AI products end to end. Head of AI at Zoomi, based in New York City." banner="/images/banners/home.jpg" bannerPosition="center 18%">
  <div class="home-hero">
    <img class="portrait" src="/images/home/portrait.jpg" alt="Adam Hare" width="220" height="220" />
    <div>
      <h1>Hello! I’m Adam Hare.</h1>
      <p class="lede">
        I’m a technical generalist who leads AI products end to end. I’m Head of AI at
        <a href="https://zoomi.ai">Zoomi, Inc</a>, a research-driven AI learning platform, where I own the
        roadmap, the client relationships, and delivery — and I still work hands-on in design and code.
        I live in New York City.
      </p>
      <p>
        This site covers my background, my work, my independent projects, and what I do outside work.
        You can find my current résumé
        <a href="https://drive.google.com/file/d/1xjcznKJJsqxp_oCw-L_vDVOf7YfeQjws/view">here</a>.
      </p>
    </div>
  </div>

  <section class="lately" aria-labelledby="lately-heading">
    <h2 id="lately-heading">Lately</h2>
    <div class="lately-grid" style={`--cols: ${columns}`}>
      {latestBook && (
        <div>
          <span class="label">Read</span>
          <ul>
            {latestBooks.map((b) => (
              <li><Fragment set:html={b.title} /> <span class="when"><Fragment set:html={b.detail} /></span></li>
            ))}
          </ul>
          <a class="more" href="/books">Everything I’ve read →</a>
        </div>
      )}
      {(recentFilm || recentEvent) && (
        <div>
          <span class="label">Watched</span>
          <ul>
            {recentFilm && (
              <li><em>{recentFilm.title}</em> ({recentFilm.year}) <span class="when">{longDate(recentFilm.watched)}</span></li>
            )}
            {recentEvent && (
              <li>{recentEvent.link ? <a href={recentEvent.link}><em>{recentEvent.name}</em></a> : <em>{recentEvent.name}</em>}{recentEvent.venue ? ` at ${recentEvent.venue}` : ''} <span class="when">{recentEvent.date}</span></li>
            )}
          </ul>
          <a class="more" href="/stage-screen">Stage &amp; Screen →</a>
        </div>
      )}
      {recentShow && (
        <div>
          <span class="label">Listened</span>
          <p>{recentShow.artist}{recentShow.city ? ` in ${recentShow.city}` : ''} <span class="when">{recentShow.date}</span></p>
          <a class="more" href="/music">Every concert →</a>
        </div>
      )}
    </div>
    {latestEssay && (
      <p class="lately-writing">
        <span class="label">Writing</span>
        <span><a href={latestEssay.url}>{latestEssay.title}</a> <span class="when-inline">{fmtMonth(latestEssay.date)}</span></span>
        <a class="more" href="https://ahare63.substack.com/">Within &amp; Without →</a>
      </p>
    )}
  </section>

  <div class="card-grid">
    <a class="card" href="/about"><h3>About</h3><p>A short bio, and the story behind the Linear A logo.</p></a>
    <a class="card" href="/background"><h3>Background</h3><p>Work experience and education, from Princeton and Oxford to Zoomi.</p></a>
    <a class="card" href="/projects"><h3>Projects</h3><p>Independent projects built with Claude Code, plus research from Princeton and Oxford.</p></a>
    <a class="card" href="/interests"><h3>Interests</h3><p>Writing, a journal club, and pages on books, music &amp; concerts, and travel.</p></a>
    <a class="card" href="/books"><h3>Books</h3><p>Favorites, long-term projects, and everything I’ve read since 2017.</p></a>
    <a class="card" href="/linear-b"><h3>Your name in Linear B</h3><p>Type a name and see it the way a Mycenaean scribe would have written it.</p></a>
  </div>

  <style>
    .lately { margin: 0.5rem 0 2rem; }
    .lately h2 { margin-top: 1.5rem; }
    .lately-grid {
      display: grid; gap: 1.6rem;
      grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    }
    @media (max-width: 40rem) {
      .lately-grid { grid-template-columns: 1fr; }
    }
    .lately .lately-writing {
      margin-top: 1.6rem; padding-top: 1rem; border-top: 1px solid var(--rule);
      display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.3rem 1rem;
    }
    .lately .lately-writing .label { display: inline; margin: 0; }
    .lately .lately-writing .more { white-space: nowrap; margin-left: auto; }
    .lately .when-inline { font-size: 0.8rem; color: var(--ink-soft); }
    .lately .label {
      display: block; font-size: 0.75rem; letter-spacing: 0.09em; text-transform: uppercase;
      color: var(--ink-soft); margin-bottom: 0.35rem;
    }
    .lately p, .lately ul { margin: 0 0 0.4rem; font-size: 0.96rem; }
    .lately ul { list-style: none; padding: 0; }
    .lately li { margin-bottom: 0.45rem; }
    .lately .when { display: block; font-size: 0.8rem; color: var(--ink-soft); }
    .lately .more { font-size: 0.85rem; }
    .home-hero {
      display: flex; gap: 1.8rem; align-items: flex-start; flex-wrap: wrap;
      margin-bottom: 1.5rem;
    }
    .portrait {
      width: 180px; height: 180px; object-fit: cover; border-radius: 50%;
      flex-shrink: 0; margin-top: 0.4rem;
    }
    .home-hero > div { flex: 1 1 20rem; }
    h1 { margin-top: 0.4rem; }
  </style>
</Base>
