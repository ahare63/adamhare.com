---
import Base from '../layouts/Base.astro';
import * as md from '../content/movies.md';
import watches from '../data/movies.json';
import { movieStats } from '../lib/movies.js';

const PROFILE = 'https://letterboxd.com/ahare63/';
const s = movieStats(watches);
const maxYear = Math.max(1, ...s.perYear.map(([, n]) => n));
const maxRating = Math.max(1, ...s.ratings.map(([, n]) => n));
const stars = (r) => '★'.repeat(Math.floor(r)) + (r % 1 ? '½' : '');
const day = (iso) => new Date(`${iso}T00:00:00Z`).toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
---
<Base title={md.frontmatter.title} description={md.frontmatter.description}>
  <h1>{md.frontmatter.title}</h1>
  <md.Content />

  <p class="movie-stats sans">
    <strong>{s.total}</strong> watches · <strong>{s.films}</strong> distinct films · <strong>{s.rewatches}</strong> rewatches
  </p>

  <h2>Films per year</h2>
  <ul class="bars">
    {s.perYear.map(([year, n]) => (
      <li>
        <span class="bar-name">{year}</span>
        <span class="bar-count">{n}</span>
        <div class="bar" style={`width:${(n / maxYear) * 100}%`}></div>
      </li>
    ))}
  </ul>

  <h2>Ratings</h2>
  <div class="ratings" role="img" aria-label={`Ratings histogram: ${s.ratings.map(([r, n]) => `${r} stars, ${n}`).join('; ')}`}>
    {s.ratings.map(([r, n]) => (
      <div class="rating-col">
        <span class="rating-count">{n || ''}</span>
        <div class="rating-track"><div class="rating-bar" style={`height:${(n / maxRating) * 100}%`}></div></div>
        <span class="rating-label">{r % 1 ? `${Math.floor(r) || ''}½` : r}</span>
      </div>
    ))}
  </div>
  <p class="sans rating-axis">Stars, in half-star steps.</p>

  {s.favorites.length > 0 && (
    <>
      <h2>Five stars</h2>
      <ul class="film-list">
        {s.favorites.map((f) => <li><span>{f.title} <span class="film-year">({f.year})</span></span></li>)}
      </ul>
    </>
  )}

  <h2>Recently watched</h2>
  <ul class="film-list">
    {s.recent.map((f) => (
      <li>
        <span>{f.title} <span class="film-year">({f.year})</span>{f.rewatch && <span class="film-tag"> rewatch</span>}</span>
        <span class="film-meta">{[f.rating && stars(f.rating), day(f.watched)].filter(Boolean).join(' · ')}</span>
      </li>
    ))}
  </ul>

  <p><a href={PROFILE}>Everything else is on Letterboxd →</a></p>

  <style>
    .movie-stats { font-size: 1.05rem; }
    .bars { list-style: none; padding: 0; max-width: 40rem; }
    .bars li { display: grid; grid-template-columns: 1fr auto; column-gap: 1rem; margin-bottom: 0.7rem; }
    .bar-count { color: var(--ink-soft); }
    .bar { grid-column: 1 / -1; height: 0.5rem; margin-top: 0.15rem; border-radius: 3px; background: var(--accent); }
    .ratings { display: grid; grid-template-columns: repeat(10, minmax(0, 1fr)); gap: 0.35rem; height: 10rem; max-width: 34rem; }
    .rating-col { display: grid; grid-template-rows: auto 1fr auto; min-width: 0; text-align: center; }
    .rating-track { display: flex; align-items: flex-end; border-bottom: 1px solid var(--rule); }
    .rating-bar { width: 100%; border-radius: 3px 3px 0 0; background: var(--accent); }
    .rating-count { font-size: 0.8rem; color: var(--ink-soft); min-height: 1.2em; }
    .rating-label { font-size: 0.8rem; color: var(--ink-soft); margin-top: 0.25rem; }
    .rating-axis { font-size: 0.85rem; color: var(--ink-soft); }
    .film-list { list-style: none; padding: 0; max-width: 40rem; }
    .film-list li { display: flex; justify-content: space-between; gap: 1rem; padding: 0.35rem 0; border-bottom: 1px solid var(--rule); }
    .film-year, .film-tag, .film-meta { color: var(--ink-soft); }
    .film-meta { white-space: nowrap; font-variant-numeric: tabular-nums; }
  </style>
</Base>
