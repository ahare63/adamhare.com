---
import Base from '../layouts/Base.astro';
import * as md from '../content/music.md';
import concerts from '../data/concerts.json';

const counts = new Map();
for (const c of concerts) counts.set(c.artist, (counts.get(c.artist) ?? 0) + 1);
const top = [...counts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0])).slice(0, 8);
const max = top.length ? top[0][1] : 1;
---
<Base title={md.frontmatter.title} description={md.frontmatter.description} wide>
  <h1>{md.frontmatter.title}</h1>
  <md.Content />

  <p class="concert-stats sans">
    <strong>{concerts.length}</strong> shows · <strong>{counts.size}</strong> distinct artists
  </p>

  <h2>Most-seen artists</h2>
  <ul class="bars">
    {top.map(([artist, n]) => (
      <li>
        <span class="bar-name">{artist}</span>
        <span class="bar-count">{n}</span>
        <div class="bar" style={`width:${(n / max) * 100}%`}></div>
      </li>
    ))}
  </ul>

  <h2>Every concert</h2>
  <p>
    <input type="text" id="concert-filter" placeholder="Filter by artist or city" aria-label="Filter concerts by artist or city" />
  </p>
  <div class="table-scroll">
    <table>
      <thead>
        <tr><th>Artist</th><th>City</th><th>Date</th></tr>
      </thead>
      <tbody id="concert-rows">
        {concerts.map((c) => (
          <tr><td>{c.artist}</td><td>{c.city}</td><td>{c.date}</td></tr>
        ))}
      </tbody>
    </table>
  </div>

  <style>
    .concert-stats { font-size: 1.05rem; }
    .bars { list-style: none; padding: 0; max-width: 40rem; }
    .bars li {
      display: grid; grid-template-columns: 1fr auto; column-gap: 1rem;
      margin-bottom: 0.7rem;
    }
    .bar-count { color: var(--ink-soft); }
    .bar { grid-column: 1 / -1; height: 0.5rem; margin-top: 0.15rem; border-radius: 3px; background: var(--accent); }
    #concert-filter {
      width: 100%; max-width: 22rem; padding: 0.45rem 0.7rem;
      font: inherit; border: 1px solid var(--rule); border-radius: 6px; background: #fff; color: var(--ink);
    }
    .table-scroll { overflow-x: auto; }
  </style>

  <script>
    const input = document.getElementById('concert-filter');
    const rows = document.querySelectorAll('#concert-rows tr');
    input.addEventListener('input', () => {
      const q = input.value.trim().toLowerCase();
      rows.forEach((tr) => {
        const [artist, city] = tr.children;
        const match = !q || artist.textContent.toLowerCase().includes(q) || city.textContent.toLowerCase().includes(q);
        tr.hidden = !match;
      });
    });
  </script>
</Base>
