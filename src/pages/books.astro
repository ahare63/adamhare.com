---
import Base from '../layouts/Base.astro';
import booksData from '../data/books.json';
import * as booksMd from '../content/books.md';

// Per-year counts are computed here, never typed by hand: each "## 2026"
// heading gets " · N books" appended, where N is the number of list items
// until the next heading.
let html = await booksMd.compiledContent();
let first = true;
html = html.replace(
  /(<h2[^>]*>)(\d{4})([\s\S]*?<\/h2>)([\s\S]*?)(?=<h2|$)/g,
  (m, open, year, close, body) => {
    const n = (body.match(/<li/g) || []).length;
    const heading = `${open}${year}<span class="count"> · ${n} book${n === 1 ? '' : 's'}</span>${close}`;
    const attr = first ? ' open' : '';
    const lead = first ? '<h2>Recently Read</h2>' : '';
    first = false;
    return `${lead}<details${attr}><summary>${heading}</summary>${body}</details>`;
  }
);

const groups = [
  ['top', null],
  ['fiction', 'Fiction'],
  ['non-fiction', 'Non-fiction'],
  ['poetry', 'Poetry'],
];

// Intro paragraphs sit above the favorites; the year list follows them.
const listStart = html.indexOf('<h2>Recently Read</h2>');
const introHtml = listStart === -1 ? '' : html.slice(0, listStart);
const listHtml = listStart === -1 ? html : html.slice(listStart);
---
<Base wide title="Books" description="What Adam Hare reads: favorites and a yearly reading log.">
  <h1>Books</h1>
  <div class="prose" set:html={introHtml} />

  <h2>Some of My Favorites</h2>
  {groups.map(([cat, label]) => {
    const items = booksData.favorites.filter((b) => b.category === cat);
    return items.length ? (
      <>
        {label && <h3>{label}</h3>}
        <ul class="favorites" style={`--n:${items.length}`} data-n={items.length}>
          {items.map((b) => (
            <li>
              {b.image && <img src={b.image} alt={b.title} loading="lazy" />}
              <span class="meta"><em>{b.title}</em> by {b.author}</span>
            </li>
          ))}
        </ul>
      </>
    ) : null;
  })}

  {booksData.longTerm.length > 0 && (
    <>
      <h2>Long-term Projects</h2>
      <ul class="favorites" style={`--n:${booksData.longTerm.length}`} data-n={booksData.longTerm.length}>
        {booksData.longTerm.map((b) => (
          <li>
            {b.image && <img src={b.image} alt={b.title} loading="lazy" />}
            <span class="meta">
              <em>{b.title}</em>{b.author && <> by {b.author}</>}{b.note && <> {b.note}</>}
            </span>
          </li>
        ))}
      </ul>
    </>
  )}

  <div class="prose" set:html={listHtml} />

  <style>
    .favorites {
      list-style: none; padding: 0; margin: 1rem 0 1.6rem;
      display: grid;
      grid-template-columns: repeat(var(--n), minmax(0, 1fr));
      gap: 1.2rem;
    }
    .favorites[data-n="3"] { max-width: 32rem; }
    @media (max-width: 700px) {
      .favorites[data-n="6"] { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    }
    @media (max-width: 420px) {
      .favorites[data-n="6"] { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }
    .favorites li { margin: 0; display: flex; flex-direction: column; gap: 0.5rem; }
    .favorites img {
      width: 100%; aspect-ratio: 2/3; object-fit: contain;
      border: 1px solid var(--rule); border-radius: 4px;
    }
    .favorites .meta { font-size: 0.9rem; color: var(--ink-soft); line-height: 1.35; }
    .favorites .meta em { color: inherit; }
    .prose :global(details) { border-top: 1px solid var(--rule); }
    .prose :global(summary) { cursor: pointer; padding: 0.4rem 0; }
    .prose :global(summary h2) { display: inline; margin: 0; }
    .prose :global(h2 .count) { font-size: 0.95rem; font-weight: 400; color: var(--ink-soft); }
  </style>
</Base>
